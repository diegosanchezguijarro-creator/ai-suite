# Server-side API keys (recommended). Never exposed to the browser.
# Values entered in the app's Settings dialog override these per-session.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint: Ollama, LM Studio, vLLM, llama.cpp, etc.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=

# Your local orchestration server (model selection, prompt engineering, etc.).
# Must expose OpenAI-compatible endpoints: GET /v1/models and POST /v1/chat/completions.
ORCHESTRATOR_BASE_URL=http://localhost:8788/v1
ORCHESTRATOR_API_KEY=

# Port the Express server listens on
PORT=8787
# Address the server binds to. Default 127.0.0.1 keeps your API keys usable
# only from this machine. Set explicitly (e.g. HOST=0.0.0.0) to expose it to
# your network — only do this if you understand the implications.
HOST=127.0.0.1