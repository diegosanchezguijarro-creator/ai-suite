# Server
PORT=8788

# Decision backend (routing + verification).
# Primary: OpenRouter Decisions API — free tier model inception/mercury-decide:free.
#   Native choice/noul/score questions with calibrated probabilities.
# Fallback: TypeSafe AI JEV via @typesafe-ai/sdk (used when OpenRouter is
#   unconfigured or errors). If both keys are set, OpenRouter wins.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inception/mercury-decide:free
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_DECISIONS_TIMEOUT_MS=8000
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# OpenCode Go subscription (preferred generative backend when set)
# Copy your API key from https://opencode.ai/console → OpenCode Go / Zen.
# OPENCODE_CONSOLE_TOKEN can list models but chat/completions needs OPENCODE_GO_API_KEY.
OPENCODE_GO_API_KEY=
# Fast model: direct chat, planner, parallel workers
OPENCODE_GO_MODEL=glm-5.3-flash
# Strong model: synthesis and rewrite passes
OPENCODE_GO_STRONG_MODEL=kimi-k2.6
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# Optional stable session id sent as x-opencode-session (helps Go prompt caching)
OPENCODE_GO_SESSION=

# Other generative LLM backends (planner, workers, synthesizer, direct chat streams)
# Auto-pick order: OPENCODE_GO_API_KEY → ANTHROPIC_API_KEY → OPENAI_API_KEY
# Set GENERATIVE_PROVIDER=opencode-go|anthropic|openai to force one.
GENERATIVE_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# Verification (parallel-analysis only)
VERIFY_NOUL_THRESHOLD=0.85
MAX_SYNTHESIS_ATTEMPTS=2

# Routing: escalate to parallel-analysis below this confidence
ROUTE_CONFIDENCE_FLOOR=0.5

# Context pruning for the augmenter
CONTEXT_CHAR_LIMIT=48000

# Keep-alive SSE interval during blocking parallel-analysis phases
KEEP_ALIVE_MS=10000
