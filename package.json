{
  "name": "ai-suite",
  "productName": "AI Suite",
  "version": "0.1.1",
  "description": "Local AI suite: orchestrator backend + chat interface + launcher dashboard",
  "author": "Diego Sanchez Guijarro",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "setup": "node scripts/install-apps.mjs && node scripts/init-env.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "start": "node src/launcher/run-headless.mjs",
    "start:electron": "electron .",
    "smoke": "node scripts/smoke-suite.mjs",
    "dist": "npm run prepare:runtime && electron-builder --win"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
